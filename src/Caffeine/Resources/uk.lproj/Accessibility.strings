/* Accessibility label for a duration menu item, %@ is the duration */
"Activate: %@" = "Увімкнути: %@";

/* Accessibility value announced when Caffeine is preventing sleep */
"Active, sleep prevented" = "Увімкнено, сон заблоковано";

/* Accessibility value announced when Caffeine is not preventing sleep */
"Inactive, sleep allowed" = "Вимкнено, сон дозволено";

/* Accessibility value announced when Super Caffeine is preventing lid-closed sleep */
"Super active, sleep prevented even with the lid closed" = "Super активний, сон заборонено навіть при закритій кришці";
